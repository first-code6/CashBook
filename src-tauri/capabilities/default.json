{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://xiaoyujiayan.com/*" },
        { "url": "https://*.xiaoyujiayan.com/*" }
      ]
    },
    "upload:default",
    "android-installer:default"
  ]
}
