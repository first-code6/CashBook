# 复制为 .env 后按需修改
# 本地私密覆盖可另建 .env.local（不会提交）

# 构建期前端版本（Web 回退用）。
# Android 运行时会优先读 tauri.conf.json 的 version（= versionName）。
# 发版时请同步改：
#   1) package.json → version
#   2) src-tauri/tauri.conf.json → version
#   3) src-tauri/Cargo.toml → version
#   4) 本文件 VITE_APP_VERSION
VITE_APP_VERSION=0.1.0

# 远程 update.json 地址（须 HTTPS，公网可访问）
# 示例内容：
# {
#   "version": "0.2.0",
#   "url": "https://your.host/cashbook-0.2.0.apk",
#   "notes": "修复若干问题"
# }
VITE_UPDATE_MANIFEST_URL=

# ---------- Android 签名（不要加 VITE_ 前缀，避免进前端包）----------
# 密钥文件路径（相对项目根，或绝对路径）
ANDROID_KEYSTORE_PATH=./src-tauri/keys/cashbook.keystore
# 密钥库密码
ANDROID_KEYSTORE_PASSWORD=
# 密钥别名
ANDROID_KEY_ALIAS=cashbook
# 密钥密码（可与库密码相同；留空则沿用 KEYSTORE_PASSWORD）
ANDROID_KEY_PASSWORD=

# 用法：
#   1. 生成密钥（示例）：
#      keytool -genkeypair -v -keystore src-tauri/keys/cashbook.keystore -alias cashbook -keyalg RSA -keysize 2048 -validity 10000
#   2. 填写上面的 ANDROID_* 变量
#   3. pnpm android:signing   # 从 .env 生成 keystore.properties 并注入 Gradle
#   4. pnpm android:build     # 签名同步 + 正式打包
#
# Android 自更新注意：
# - 新 APK 必须与已安装包同 applicationId（tauri.conf identifier）
# - 必须使用同一签名密钥，否则无法覆盖安装
# - Android 8+ 需用户允许「安装未知应用」；系统安装确认框无法跳过
